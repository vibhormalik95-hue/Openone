{
	email {$ACME_EMAIL}
	admin localhost:2019
	# Access logs intentionally absent: never record MCP tokens, URL queries or bodies.
	log {
		level ERROR
		exclude http.log.access http.log.error
	}
}

{$DOMAIN} {
	# Explicit Let's Encrypt issuer; public DNS + TCP 80/443 are required.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-store
		-Server
	}
	@dashboard path / /onboard /onboard/* /account /account/* /_astro/*
	header @dashboard Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	request_body {
		max_size 1MB
	}
	reverse_proxy {
		import /etc/caddy/upstream.conf
		flush_interval -1
		stream_timeout 1h
		stream_close_delay 45s
		health_uri /health/ready
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
			# No read/write timeout cuts a live SSE response short.
			read_timeout 0
			write_timeout 0
			compression off
		}
		header_up -X-Hivemind-Tenant
		header_up -X-Hivemind-Project
	}
}
