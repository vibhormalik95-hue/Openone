---
const { title } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="referrer" content="no-referrer"/><title>{title} · Hivemind Scale</title></head><body><header><a href="/">HIVEMIND SCALE</a><a href="/account/">Account</a></header><main><slot/></main><footer>Persistent project memory. Your tools, your decisions.</footer></body></html>
<style is:global>
:root{font-family:system-ui,sans-serif;color:#e9edea;background:#0e1916;font-size:18px;line-height:1.55}*{box-sizing:border-box}body{margin:0}header,main,footer{width:min(1060px,92vw);margin:auto}header{padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;font-size:.8rem;letter-spacing:.1em}main{padding:2rem 0 5rem;min-height:70vh}footer{padding:2rem 0;border-top:1px solid #36544a;color:#adc3b9;font-size:.8rem}a{color:#aff3c4;text-underline-offset:.2em}h1{font-size:clamp(2.4rem,6vw,4.6rem);max-width:900px;line-height:1.1;letter-spacing:-.045em;margin:1.4rem 0}h2{line-height:1.2}p{max-width:740px;color:#c4d5cd}.eyebrow{color:#aff3c4;font-size:.75rem;text-transform:uppercase;letter-spacing:.18em}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.2rem;margin:3rem 0}.card,section{border:1px solid #36544a;padding:1.5rem;border-radius:12px;margin:1rem 0}button{padding:.8rem 1.2rem;background:#aff3c4;color:#0e1916;border:0;border-radius:6px;font:inherit;font-weight:650;cursor:pointer}button:disabled{opacity:.5;cursor:wait}button.secondary{background:#273e35;color:#e9edea}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #f4ce7a;outline-offset:4px}label{display:block;margin:.8rem 0;font-size:.9rem}input,select,textarea{display:block;max-width:100%;width:100%;margin:.4rem 0;padding:.65rem;background:#15251f;color:#e9edea;border:1px solid #708d7f;border-radius:4px;font:inherit}input[type=checkbox]{display:inline;width:auto}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:1rem;background:#15251f;border:1px solid #36544a;font-size:.8rem}code{overflow-wrap:anywhere}.price{font-size:2rem;color:#aff3c4}.muted{font-size:.8rem;color:#adc3b9}#status,[role=alert]{color:#f4ce7a;min-height:1.5rem}ul{padding-left:1.2rem}[hidden]{display:none!important}.row{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}.row>*{flex:1}small{font-size:.75rem}
</style>
